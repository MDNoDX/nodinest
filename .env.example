# ─── NodiNest environment variables ───────────────────────────────────────
# Copy to .env.local for local development. NEVER commit real values.

# PostgreSQL connection string.
# Local:     postgres://USER@127.0.0.1:5432/nodinest
# Supabase:  use the "Transaction pooler" URI (port 6543) for the app.
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/nodinest
# Direct (session / non-pooled) connection used only for migrations.
# Supabase: the "Direct connection" or "Session pooler" URI (port 5432).
DATABASE_URL_UNPOOLED=
# Role the app switches to for row-level-security–protected queries.
# Created by the migrations. Leave empty only if your provider forbids SET ROLE
# (application-level checks still apply, RLS becomes inactive).
DB_RLS_ROLE=nodinest_app

# ─── Auth (Better Auth + Google OAuth) ──────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# Public base URL of the app (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google account emails that become superadmin on first
# verified Google sign-in. Assigned server-side only.
SUPERADMIN_EMAILS=mdnodx@gmail.com

# Development-only email+password login used for local testing and E2E.
# Ignored (hard-disabled) when NODE_ENV=production.
ENABLE_DEV_LOGIN=false

# ─── Gemini AI (optional — the app works without it) ────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Free-tier fallbacks tried in order when the primary model is rate-limited.
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.8-flash
# Per-user AI requests per day (also editable in Admin → AI settings).
AI_DAILY_LIMIT_PER_USER=40

# ─── Vercel Blob (optional — uploads disabled without it) ───────────────────
# Created by `vercel blob create-store`; server-only, never expose to the browser.
BLOB_READ_WRITE_TOKEN=
# Max PDF/EPUB upload size in megabytes (images are capped at 8 MB).
UPLOAD_MAX_MB=50
