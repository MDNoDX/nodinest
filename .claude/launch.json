{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nodinest-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "-p",
        "3100"
      ],
      "port": 3100,
      "autoPort": false
    },
    {
      "name": "nodinest-dev-ai",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "GEMINI_API_KEY=\"$(head -1 \"$HOME/Library/Application Support/Nodogram/gemini.key\" | tr -d '[:space:]')\" exec npx next dev -p 3100"
      ],
      "port": 3100,
      "autoPort": false
    },
    {
      "name": "nodinest-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3100"
      ],
      "port": 3100,
      "autoPort": false
    }
  ]
}
